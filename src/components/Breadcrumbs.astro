---
const { path = Astro.url.pathname } = Astro;

// Split the path and create breadcrumb items
const segments = path.split('/').filter(Boolean);
let currentPath = '';

const labelOverrides: Record<string, string> = {
  'services': 'Services',
  'depannage-electrique': 'Dépannage Électrique',
  'installation-renovation': 'Installation & Rénovation',
  'mise-en-conformite-rgie': 'Mise en Conformité RGIE',
  'tableau-electrique': 'Tableau Électrique',
  'borne-recharge': 'Bornes de Recharge',
  'domotique': 'Domotique',
  'zones': 'Zones d\'Intervention',
  'blog': 'Blog',
  'a-propos': 'À Propos',
  'contact': 'Contact',
  'mentions-legales': 'Mentions Légales',
  'politique-de-confidentialite': 'Politique de Confidentialité'
};

const breadcrumbs = [
  { name: 'Accueil', url: '/' },
  ...segments.map((segment) => {
    currentPath += `/${segment}`;
    const normalizedUrl = currentPath.endsWith('/') ? currentPath : `${currentPath}/`;
    
    const name = labelOverrides[segment] || segment
      .replace(/-/g, ' ')
      .replace(/\b\w/g, l => l.toUpperCase());
      
    return { name, url: normalizedUrl };
  })
];

// Don't show breadcrumbs on homepage
if (breadcrumbs.length === 1) {
  return null;
}

// Generate JSON-LD Schema with strict trailing slashes matching canonicals
const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.map((crumb, index) => {
    const rawUrl = crumb.url === '/' ? '/' : (crumb.url.endsWith('/') ? crumb.url : `${crumb.url}/`);
    return {
      "@type": "ListItem",
      "position": index + 1,
      "name": crumb.name,
      "item": new URL(rawUrl, Astro.site || 'https://www.allo-electricien.be').href
    };
  })
};
---

{breadcrumbs.length > 1 && (
  <nav aria-label="Breadcrumb" class="bg-navy border-b border-white/5 py-3">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 text-sm text-gray-400">
        {breadcrumbs.map((crumb, index) => {
          const isLast = index === breadcrumbs.length - 1;
          
          return (
            <li class="flex items-center">
              {index > 0 && <span class="material-icons text-sm mx-2 opacity-50">chevron_right</span>}
              {isLast ? (
                <span class="text-white font-medium" aria-current="page">{crumb.name}</span>
              ) : (
                <a href={crumb.url} class="hover:text-primary transition-colors">{crumb.name}</a>
              )}
            </li>
          );
        })}
      </ol>
    </div>
  </nav>

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
)}
