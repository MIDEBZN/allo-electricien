---
interface Props {
  title: string;
  subtitle: string;
}
const { title, subtitle } = Astro.props;
---
<div class="bg-primary text-navy p-8 rounded-lg my-8 text-center shadow-lg">
  <h3 class="text-2xl font-bold mb-4">{title}</h3>
  <p class="mb-6">{subtitle}</p>
  <a href="/contact/" class="bg-navy text-white px-6 py-3 rounded-lg font-bold hover:bg-opacity-90 transition-all">Demander un devis</a>
</div>
