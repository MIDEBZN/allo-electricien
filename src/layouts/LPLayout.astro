---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  heroBadge?: string;
}

const { title, description, heroBadge = "Électriciens Agréés RGIE • Intervention Rapide 7j/7" } = Astro.props;
const currentUrl = Astro.url.href;
---

<!doctype html>
<html lang="fr" class="dark scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={currentUrl} />
    <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
    <title>{title} | Allo Électricien</title>
  </head>
  <body class="font-display bg-bg-dark text-slate-100 antialiased overflow-x-hidden pb-20 sm:pb-0">

    <!-- Top Reassuring Header (No distracting navigation links to maximize conversion) -->
    <header class="sticky top-0 z-40 bg-navy/95 backdrop-blur-md border-b border-white/10 shadow-lg">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-20">
          
          <!-- Logo with reassurance -->
          <div class="flex items-center gap-3">
            <div class="w-11 h-11 bg-primary rounded-xl flex items-center justify-center shadow-lg shadow-primary/20">
              <span class="material-icons text-navy text-2xl font-bold">electric_bolt</span>
            </div>
            <div>
              <span class="text-xl sm:text-2xl font-black tracking-tight text-white block">
                Allo<span class="text-primary">Électricien</span>
              </span>
              <span class="text-xs text-slate-400 hidden sm:block">{heroBadge}</span>
            </div>
          </div>

          <!-- Trust Badges (Desktop) -->
          <div class="hidden lg:flex items-center gap-6 text-xs text-slate-300">
            <div class="flex items-center gap-2">
              <span class="material-icons text-emerald-400 text-base">verified</span>
              <span>Agrément RGIE 100% Conforme</span>
            </div>
            <div class="flex items-center gap-1.5 bg-white/5 px-3 py-1.5 rounded-full border border-white/10">
              <span class="text-primary font-bold">★ 4.9/5</span>
              <span class="text-slate-400">(120+ avis Google)</span>
            </div>
          </div>

          <!-- Direct Call Button Header -->
          <div class="flex items-center gap-3">
            <a
              href="tel:0465673462"
              class="flex items-center gap-2 bg-primary hover:bg-primary-hover text-navy font-black text-sm sm:text-base px-4 sm:px-6 py-2.5 sm:py-3 rounded-xl shadow-lg shadow-primary/25 transition-all transform hover:scale-105"
              data-tracking="header-call"
            >
              <span class="material-icons text-lg sm:text-xl animate-bounce">call</span>
              <span class="hidden sm:inline">0465 67 34 62</span>
              <span class="sm:hidden font-bold">0465 67 34 62</span>
            </a>
          </div>

        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main>
      <slot />
    </main>

    <!-- Simple Distraction-Free Footer -->
    <footer class="bg-navy border-t border-white/10 py-10 text-center text-sm text-slate-400">
      <div class="max-w-5xl mx-auto px-4">
        <div class="flex items-center justify-center gap-2 mb-3">
          <div class="w-8 h-8 bg-primary rounded-lg flex items-center justify-center text-navy font-bold">
            <span class="material-icons text-base">electric_bolt</span>
          </div>
          <span class="text-lg font-bold text-white">Allo Électricien</span>
        </div>
        <p class="mb-4 text-xs sm:text-sm text-slate-400">
          Intervention d'urgence, dépannage, rénovation et mise en conformité électrique. Déplacement rapide 7j/7.
        </p>
        <p class="text-xs text-slate-500">
          © {new Date().getFullYear()} Allo Électricien. Tous droits réservés. Ligne directe : <a href="tel:0465673462" class="text-primary font-bold hover:underline">0465 67 34 62</a>
        </p>
      </div>
    </footer>

    <!-- STICKY MOBILE CALL BAR (Ultra high conversion on mobile ads) -->
    <div class="fixed bottom-0 left-0 right-0 z-50 p-3 bg-navy/95 backdrop-blur-lg border-t border-white/10 flex items-center gap-2 sm:hidden shadow-2xl">
      <a
        href="tel:0465673462"
        class="flex-1 flex items-center justify-center gap-2 bg-primary text-navy font-black py-3.5 px-3 rounded-xl shadow-lg pulse-animation text-sm tracking-wide"
        data-tracking="sticky-mobile-call"
      >
        <span class="material-icons text-xl">call</span>
        <span>APPELER 0465 67 34 62</span>
      </a>
      <a
        href="https://wa.me/32465673462"
        target="_blank"
        rel="noopener noreferrer"
        class="w-12 h-12 flex-shrink-0 bg-[#25D366] text-white rounded-xl flex items-center justify-center shadow-lg hover:scale-105 transition-transform"
        aria-label="WhatsApp direct"
      >
        <svg fill="currentColor" height="22" viewBox="0 0 24 24" width="22"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
      </a>
    </div>

  </body>
</html>

