---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

const services = [
  {
    title: "Dépannage d'Urgence",
    href: "/services/depannage-electrique/",
    desc: "Coupure de courant, court-circuit ou disjoncteur qui saute. Intervention d'urgence en moins de 45 minutes, 24h/24 et 7j/7.",
    icon: "bolt"
  },
  {
    title: "Installation & Rénovation",
    href: "/services/installation-renovation/",
    desc: "Rénovation électrique complète, ajout de prises, tirage de câbles aux normes et appareillage de qualité (Niko, Legrand).",
    icon: "home"
  },
  {
    title: "Mise en Conformité RGIE",
    href: "/services/mise-en-conformite-rgie/",
    desc: "Préparation aux contrôles de vente ou périodiques, schémas unifilaires et mise aux normes du RGIE belge.",
    icon: "check_circle"
  },
  {
    title: "Tableau Électrique",
    href: "/services/tableau-electrique/",
    desc: "Remplacement de coffrets vétustes, disjoncteurs magnétothermiques et différentiels 30mA/300mA certifiés.",
    icon: "settings_input_component"
  },
  {
    title: "Domotique & Smart Home",
    href: "/services/domotique/",
    desc: "Installation de systèmes intelligents (Niko Home Control) pour la gestion du chauffage, de l'éclairage et des volets.",
    icon: "router"
  },
  {
    title: "Bornes de Recharge",
    href: "/services/borne-recharge/",
    desc: "Installation certifiée de bornes Wallbox pour véhicules électriques à domicile et en copropriété avec délestage.",
    icon: "electric_car"
  }
];

const faqs = [
  {
    q: "Comment sont calculés vos tarifs d'urgence ?",
    a: "Nos tarifs d'urgence sont transparents. Un forfait de déplacement et la première heure d'intervention vous sont annoncés par téléphone avant le départ de notre technicien. Une majoration transparente s'applique pour les interventions de nuit et les week-ends."
  },
  {
    q: "Intervenez-vous les week-ends et jours fériés ?",
    a: "Oui, notre service de garde pour dépannage d'urgence est actif 24h/24, 7j/7, 365 jours par an, y compris le samedi, le dimanche et les jours fériés dans toutes les communes de Bruxelles."
  },
  {
    q: "Quelles garanties offrez-vous sur vos travaux et installations ?",
    a: "Toutes nos réparations et installations électriques sont garanties et exécutées selon les règles du RGIE belge. Nous utilisons exclusivement des composants certifiés CE et CEBEC de marques de référence (Hager, Schneider, Legrand, Niko)."
  }
];
---

<Layout 
  title="Électricien Bruxelles 24/7 | Dépannage Urgent < 45 min & RGIE" 
  description="Électricien agréé à Bruxelles. Dépannage urgent 24h/24 et 7j/7 en moins de 45 min, mise en conformité RGIE et rénovation. Devis gratuit au 0465 67 34 62."
>

  <!-- Hero -->
  <section class="relative bg-navy overflow-hidden">
    <div class="absolute inset-0 opacity-20 hero-pattern"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-navy via-navy to-navy/80 z-10"></div>
    <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32 flex flex-col md:flex-row items-center">
      <div class="w-full md:w-1/2 text-center md:text-left mb-12 md:mb-0">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/20 text-primary text-sm font-bold mb-6 border border-primary/30">
          <span class="w-2 h-2 rounded-full bg-primary animate-ping"></span>
          DISPONIBLE MAINTENANT 24/7
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-6">
          Urgence Électrique <br/>
          <span class="text-primary">24/7 à Bruxelles</span>
        </h1>
        <p class="text-lg text-gray-300 mb-8 max-w-lg mx-auto md:mx-0">
          Intervention d'urgence en moins de 45 minutes pour vos pannes de courant, installations et mises en conformité. Électriciens qualifiés et agréés RGIE.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
          <a href="tel:0465673462" class="flex items-center justify-center gap-2 bg-primary hover:bg-primary-hover text-navy text-lg font-bold px-8 py-4 rounded-xl shadow-[0_0_20px_rgba(253,186,18,0.4)] transition-all hover:-translate-y-1">
            <span class="material-icons">call</span>
            Appeler le 0465 67 34 62
          </a>
          <a href="/contact/" class="flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 backdrop-blur-sm text-white text-lg font-semibold px-8 py-4 rounded-xl border border-white/20 transition-all">
            Demander un devis
          </a>
        </div>
      </div>
      <div class="w-full md:w-1/2 relative h-[400px] md:h-[500px] rounded-2xl overflow-hidden shadow-2xl border-4 border-navy-light/50">
        <img alt="Électricien Allo Électricien en intervention de dépannage" class="absolute inset-0 w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuC8wrs8t-IQKlkTIV25wgeygC-QuFjVThkN7YJp151bzlPu6Hhn-uF5CKyIRN_Ewz2pbmHWwUoEEcOLkQKZD1E5bUfgs1YRDCmuA_ZDkgu53HrNx9CaGksUtFK_AvjuYtW22XZgn0eRgjx5hxdTlJ5m9BrTCuZW9QHC48XVzr9it0L_FlzzFrv-yMBV4Yy6XEAmIeuegjVVBgRSRnl5fUNq06lvIlbGhGDBh_Hz4iTOcRIFGg29X8bZwvFQPqKgi0vOh2xt_V_Fqek" />
        <div class="absolute inset-0 bg-gradient-to-t from-navy via-transparent to-transparent opacity-60"></div>
        <div class="absolute bottom-6 left-6 right-6 bg-white/10 backdrop-blur-md p-4 rounded-xl border border-white/20 flex items-center gap-4">
          <div class="bg-green-500 rounded-full p-2">
            <span class="material-icons text-white">verified_user</span>
          </div>
          <div>
            <p class="text-white font-bold">Électriciens Agréés</p>
            <p class="text-gray-300 text-sm">Normes RGIE & Garantie</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Points Clés -->
  <section class="bg-navy-light border-y border-white/5 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div class="flex flex-col items-center">
          <div class="text-4xl font-bold text-primary mb-2">24/7</div>
          <div class="text-gray-300 text-sm uppercase tracking-wider font-semibold">Service d'Urgence</div>
        </div>
        <div class="flex flex-col items-center">
          <div class="text-4xl font-bold text-primary mb-2">&lt; 45m</div>
          <div class="text-gray-300 text-sm uppercase tracking-wider font-semibold">Délai d'Arrivée</div>
        </div>
        <div class="flex flex-col items-center">
          <div class="text-4xl font-bold text-primary mb-2">19</div>
          <div class="text-gray-300 text-sm uppercase tracking-wider font-semibold">Communes Couvertes</div>
        </div>
        <div class="flex flex-col items-center">
          <div class="text-4xl font-bold text-primary mb-2">100%</div>
          <div class="text-gray-300 text-sm uppercase tracking-wider font-semibold">Conforme RGIE</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pourquoi nous choisir -->
  <section class="py-20 bg-bg-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Pourquoi faire appel à Allo Électricien ?</h2>
        <div class="h-1 w-20 bg-primary mx-auto rounded-full"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="bg-navy p-8 rounded-xl shadow-lg border-b-4 border-primary hover:-translate-y-2 transition-transform duration-300">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mb-6 mx-auto">
            <span class="material-icons text-3xl text-primary">timer</span>
          </div>
          <h3 class="text-xl font-bold text-white text-center mb-3">Intervention Rapide</h3>
          <p class="text-gray-400 text-center text-sm">Nous arrivons chez vous en moins de 45 minutes pour les pannes et urgences électriques.</p>
        </div>
        <div class="bg-navy p-8 rounded-xl shadow-lg border-b-4 border-primary hover:-translate-y-2 transition-transform duration-300">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mb-6 mx-auto">
            <span class="material-icons text-3xl text-primary">verified</span>
          </div>
          <h3 class="text-xl font-bold text-white text-center mb-3">Conformité RGIE</h3>
          <p class="text-gray-400 text-center text-sm">Tous nos travaux respectent strictement la réglementation officielle belge du RGIE.</p>
        </div>
        <div class="bg-navy p-8 rounded-xl shadow-lg border-b-4 border-primary hover:-translate-y-2 transition-transform duration-300">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mb-6 mx-auto">
            <span class="material-icons text-3xl text-primary">euro</span>
          </div>
          <h3 class="text-xl font-bold text-white text-center mb-3">Devis Transparent</h3>
          <p class="text-gray-400 text-center text-sm">Tarif annoncé avant toute manipulation. Aucune mauvaise surprise sur la facture.</p>
        </div>
        <div class="bg-navy p-8 rounded-xl shadow-lg border-b-4 border-primary hover:-translate-y-2 transition-transform duration-300">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mb-6 mx-auto">
            <span class="material-icons text-3xl text-primary">handshake</span>
          </div>
          <h3 class="text-xl font-bold text-white text-center mb-3">Garantie & Sécurité</h3>
          <p class="text-gray-400 text-center text-sm">Composants de grandes marques et facture détaillée pour votre assurance habitation.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="py-20 bg-bg-dark bg-pattern">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row justify-between items-end mb-12">
        <div>
          <span class="text-primary font-bold tracking-wider uppercase text-sm mb-2 block">Nos Expertises</span>
          <h2 class="text-3xl md:text-4xl font-bold text-white">Services Électriques Complets</h2>
        </div>
        <a href="/services/" class="hidden md:inline-flex items-center gap-2 text-primary font-semibold hover:text-white transition-colors mt-4 md:mt-0">
          Voir tous les services <span class="material-icons text-sm">arrow_forward</span>
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map(s => (
          <div class="group bg-navy p-8 rounded-xl shadow-md border border-white/5 glow-hover transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="w-14 h-14 bg-primary rounded-lg flex items-center justify-center mb-6 shadow-lg shadow-primary/30 group-hover:scale-110 transition-transform">
                <span class="material-icons text-navy text-3xl">{s.icon}</span>
              </div>
              <h3 class="text-xl font-bold text-white mb-3">{s.title}</h3>
              <p class="text-gray-400 text-sm mb-6 leading-relaxed">{s.desc}</p>
            </div>
            <a href={s.href} class="text-accent-blue text-sm font-bold flex items-center gap-1 group-hover:translate-x-2 transition-transform">
              Découvrir la prestation <span class="material-icons text-xs">arrow_forward_ios</span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Avis Clients & FAQ -->
  <section class="py-20 bg-bg-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        <!-- Avis -->
        <div>
          <h2 class="text-3xl font-bold text-white mb-6">Témoignages Clients</h2>
          <div class="space-y-6">
            <div class="bg-white text-navy p-6 rounded-xl shadow-lg relative">
              <div class="absolute -top-3 -right-3 w-10 h-10 bg-primary rounded-full flex items-center justify-center text-navy font-bold shadow-md">
                <span class="material-icons text-sm">format_quote</span>
              </div>
              <div class="flex text-primary mb-3">
                <span class="material-icons text-sm">star</span>
                <span class="material-icons text-sm">star</span>
                <span class="material-icons text-sm">star</span>
                <span class="material-icons text-sm">star</span>
                <span class="material-icons text-sm">star</span>
              </div>
              <p class="text-sm italic mb-4">"Intervention super rapide un dimanche soir. L'électricien était très professionnel et a résolu notre panne de courant en 20 minutes. Je recommande vivement !"</p>
              <span class="font-bold text-sm">Thomas D. <span class="text-gray-400 font-normal text-xs">- Bruxelles</span></span>
            </div>
            <div class="bg-white text-navy p-6 rounded-xl shadow-lg opacity-90 scale-95 origin-left">
              <div class="flex text-primary mb-3">
                <span class="material-icons text-sm">star</span>
                <span class="material-icons text-sm">star</span>
                <span class="material-icons text-sm">star</span>
                <span class="material-icons text-sm">star</span>
                <span class="material-icons text-sm">star_half</span>
              </div>
              <p class="text-sm italic mb-4">"Mise en conformité réalisée avec succès. Le dossier était complet et le contrôle a été validé du premier coup. Merci pour le sérieux."</p>
              <span class="font-bold text-sm">Sarah L. <span class="text-gray-400 font-normal text-xs">- Ixelles</span></span>
            </div>
          </div>
        </div>

        <!-- FAQ -->
        <div>
          <h2 class="text-3xl font-bold text-white mb-6">Questions Fréquentes</h2>
          <div class="space-y-4">
            {faqs.map(f => (
              <details class="group bg-navy border border-white/10 rounded-xl overflow-hidden shadow-lg">
                <summary class="flex justify-between items-center p-6 cursor-pointer bg-navy-light text-white font-semibold text-lg hover:bg-opacity-80 transition-colors">
                  <span class="flex items-center gap-3"><span class="material-icons text-primary">help_outline</span>{f.q}</span>
                  <span class="transition-transform duration-300 group-open:rotate-180 material-icons text-primary text-2xl">expand_more</span>
                </summary>
                <div class="p-6 bg-navy text-gray-300 border-t border-white/5">
                  <p>{f.a}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-navy py-24 text-center">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl md:text-5xl font-bold text-white mb-6">Besoin d'un Électricien ?</h2>
      <p class="text-xl text-gray-300 mb-10">Ne laissez pas vos problèmes électriques sans réponse. Nos électriciens interviennent en moins de 45 minutes.</p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="tel:0465673462" class="flex items-center justify-center gap-2 bg-primary hover:bg-primary-hover text-navy font-bold text-lg px-8 py-4 rounded-lg transition-colors shadow-lg shadow-primary/20">
          <span class="material-icons">phone</span>
          Appeler le 0465 67 34 62
        </a>
        <a href="/contact/" class="flex items-center justify-center gap-2 bg-transparent border-2 border-white text-white hover:bg-white hover:text-navy font-bold text-lg px-8 py-4 rounded-lg transition-colors">
          <span class="material-icons">description</span>
          Demander un Devis en ligne
        </a>
      </div>
    </div>
  </section>

  <!-- Schema Markup -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Electrician",
    "name": "Allo Électricien",
    "image": "https://www.allo-electricien.be/og-image.jpg",
    "logo": "https://www.allo-electricien.be/favicon.svg",
    "@id": "https://www.allo-electricien.be/#electrician",
    "url": "https://www.allo-electricien.be/",
    "telephone": "0465673462",
    "email": "contact@allo-electricien.be",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Rue Froebel 3",
      "addressLocality": "Bruxelles",
      "postalCode": "1000",
      "addressCountry": "BE"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 50.8503,
      "longitude": 4.3517
    },
    "openingHoursSpecification": [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": "08:00",
        "closes": "18:00"
      },
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Saturday"],
        "opens": "09:00",
        "closes": "14:00"
      },
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
        "description": "Service de garde urgence électrique 24/7",
        "opens": "00:00",
        "closes": "23:59"
      }
    ],
    "priceRange": "€€",
    "areaServed": [
      {
        "@type": "City",
        "name": "Bruxelles"
      },
      {
        "@type": "AdministrativeArea",
        "name": "Région de Bruxelles-Capitale"
      }
    ]
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": f.a
      }
    }))
  })} />

</Layout>
