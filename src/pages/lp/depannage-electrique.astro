---
import LPLayout from '../../layouts/LPLayout.astro';

const zones = [
  "Bruxelles-Ville", "Schaerbeek", "Ixelles", "Uccle", "Anderlecht", 
  "Molenbeek", "Saint-Gilles", "Etterbeek", "Woluwe-Saint-Pierre", 
  "Woluwe-Saint-Lambert", "Forest", "Jette", "Auderghem", "Evere"
];

const emergencies = [
  {
    icon: "flash_off",
    title: "Coupure de courant totale",
    desc: "Votre logement ou commerce est plongé dans le noir ? Diagnostic immédiat et recherche de panne rapide.",
    tag: "Urgence Absolue"
  },
  {
    icon: "power",
    title: "Disjoncteur qui saute",
    desc: "Le différentiel principal refuse de remonter ? Localisation du circuit en fuite ou du court-circuit.",
    tag: "Fréquent"
  },
  {
    icon: "warning",
    title: "Odeur de brûlé / Grésillement",
    desc: "Étincelles ou odeur anormale au tableau ? Coupez le disjoncteur général et appelez-nous immédiatement.",
    tag: "Risque Incendie"
  },
  {
    icon: "outlet",
    title: "Prise ou interrupteur brûlé",
    desc: "Surchauffe, noircissement ou faux contact dangereux. Remplacement et sécurisation aux normes RGIE.",
    tag: "Sécurité"
  }
];

const faqs = [
  {
    q: "En combien de temps arrive votre électricien à Bruxelles ?",
    a: "Grâce à notre équipe d'électriciens mobiles répartis sur Bruxelles et sa périphérie, nous intervenons en moyenne entre 30 et 45 minutes après votre appel d'urgence."
  },
  {
    q: "Quel est le coût d'un dépannage d'urgence ?",
    a: "Nous appliquons une politique de transparence totale : dès votre appel, nous vous donnons une estimation claire. Une fois sur place, un devis précis vous est présenté avant tout début d'intervention. Aucune mauvaise surprise !"
  },
  {
    q: "Intervenez-vous la nuit, le week-end et les jours fériés ?",
    a: "Oui, notre service de garde pour urgence électrique est actif 24h/24, 7j/7, 365 jours par an, y compris les dimanches et jours fériés."
  },
  {
    q: "Délivrez-vous une facture pour mon assurance habitation ?",
    a: "Absolument. Nous vous remettons une facture officielle détaillée conforme aux exigences des compagnies d'assurance belges en cas de dégât des eaux, surtension ou sinistre."
  }
];
---

<LPLayout 
  title="Dépannage Électrique Bruxelles 24/7 | Arrivée en <45 min"
  description="Dépannage électrique d'urgence à Bruxelles. Intervention en 30-45min 24h/24 et 7j/7. Panne de courant, court-circuit, disjoncteur. Appelez le 0465 67 34 62."
  heroBadge="Urgence Électrique 24/7 • Bruxelles & Environs"
>

  <!-- HERO SECTION - PANIC REDUCTION & RAPID CALL -->
  <section class="relative pt-8 pb-16 md:pt-14 md:pb-24 overflow-hidden border-b border-white/10 hero-pattern">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      
      <!-- Top Alert Pill -->
      <div class="flex justify-center mb-6">
        <div class="inline-flex items-center gap-2 bg-red-500/15 border border-red-500/30 text-red-300 px-4 py-2 rounded-full text-xs sm:text-sm font-bold tracking-wide animate-pulse">
          <span class="w-2.5 h-2.5 rounded-full bg-red-500 animate-ping"></span>
          <span>DÉPANNEURS EN SERVICE ACTUELLEMENT SUR BRUXELLES</span>
        </div>
      </div>

      <div class="text-center max-w-3xl mx-auto">
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white leading-tight mb-6">
          Panne de Courant ou Court-Circuit ? <br />
          <span class="text-primary underline decoration-primary/40 underline-offset-8">Chez vous en moins de 45 min.</span>
        </h1>

        <p class="text-base sm:text-xl text-slate-300 mb-8 leading-relaxed">
          Urgence électrique 24h/24 & 7j/7 dans les 19 communes de Bruxelles. 
          Diagnostic immédiat, électricien agréé RGIE, prix annoncé avant travaux.
        </p>

        <!-- Big Phone Button (Conversion Centerpiece) -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-8">
          <a
            href="tel:0465673462"
            class="w-full sm:w-auto flex items-center justify-center gap-3 bg-primary hover:bg-primary-hover text-navy font-black text-xl sm:text-2xl py-5 px-8 rounded-2xl shadow-[0_0_35px_rgba(253,186,18,0.5)] pulse-animation transition-all transform hover:-translate-y-1"
            data-tracking="hero-main-call"
          >
            <span class="material-icons text-3xl">call</span>
            <span>0465 67 34 62</span>
          </a>

          <a
            href="https://wa.me/32465673462"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-base sm:text-lg py-5 px-6 rounded-2xl border border-emerald-400/30 transition-colors"
          >
            <span class="material-icons text-2xl">chat</span>
            <span>WhatsApp Direct</span>
          </a>
        </div>

        <!-- 4 Fast Trust Bullets -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-left max-w-4xl mx-auto pt-4 border-t border-white/10">
          <div class="flex items-center gap-2 bg-white/5 p-3 rounded-xl border border-white/5">
            <span class="material-icons text-primary text-xl">schedule</span>
            <div>
              <p class="text-xs text-slate-400">Délai express</p>
              <p class="text-sm font-bold text-white">30 à 45 minutes</p>
            </div>
          </div>
          <div class="flex items-center gap-2 bg-white/5 p-3 rounded-xl border border-white/5">
            <span class="material-icons text-primary text-xl">verified_user</span>
            <div>
              <p class="text-xs text-slate-400">Qualité</p>
              <p class="text-sm font-bold text-white">Agréé RGIE</p>
            </div>
          </div>
          <div class="flex items-center gap-2 bg-white/5 p-3 rounded-xl border border-white/5">
            <span class="material-icons text-primary text-xl">price_check</span>
            <div>
              <p class="text-xs text-slate-400">Transparence</p>
              <p class="text-sm font-bold text-white">Prix avant travaux</p>
            </div>
          </div>
          <div class="flex items-center gap-2 bg-white/5 p-3 rounded-xl border border-white/5">
            <span class="material-icons text-primary text-xl">point_of_sale</span>
            <div>
              <p class="text-xs text-slate-400">Paiement facile</p>
              <p class="text-sm font-bold text-white">Bancontact / Cash</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- COMMON EMERGENCIES SOLVED -->
  <section class="py-16 bg-navy/40">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <h2 class="text-2xl sm:text-4xl font-black text-white mb-3">
          Quel problème électrique rencontrez-vous ?
        </h2>
        <p class="text-slate-400 max-w-2xl mx-auto">
          Nos véhicules d'intervention sont entièrement équipés de matériel de remplacement pour réparer immédiatement sur place.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {emergencies.map((item) => (
          <div class="bg-navy border border-white/10 rounded-2xl p-6 sm:p-8 flex flex-col justify-between hover:border-primary/50 transition-all glow-hover">
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center text-primary">
                  <span class="material-icons text-2xl">{item.icon}</span>
                </div>
                <span class="text-xs font-bold uppercase tracking-wider bg-red-500/10 text-red-400 border border-red-500/20 px-3 py-1 rounded-full">
                  {item.tag}
                </span>
              </div>
              <h3 class="text-xl font-bold text-white mb-2">{item.title}</h3>
              <p class="text-slate-300 text-sm leading-relaxed mb-6">{item.desc}</p>
            </div>
            <a
              href="tel:0465673462"
              class="w-full flex items-center justify-center gap-2 bg-white/10 hover:bg-primary hover:text-navy text-white font-bold py-3 px-4 rounded-xl transition-all"
            >
              <span class="material-icons text-lg">call</span>
              <span>Demander un dépanneur</span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3-STEP REASSURING PROCESS -->
  <section class="py-16 border-t border-b border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <span class="text-xs uppercase tracking-widest text-primary font-bold">Simple, Rapide, Sans Stress</span>
        <h2 class="text-2xl sm:text-4xl font-black text-white mt-1">Comment se passe votre dépannage ?</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
        <!-- Step 1 -->
        <div class="bg-navy/80 border border-white/10 rounded-2xl p-6 relative">
          <span class="text-5xl font-black text-primary/20 absolute top-4 right-4">01</span>
          <div class="w-12 h-12 bg-primary rounded-xl flex items-center justify-center text-navy font-black text-xl mb-4">
            <span class="material-icons">phone_in_talk</span>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">1. Appel immédiat</h3>
          <p class="text-sm text-slate-300">
            Vous composez le <strong class="text-primary">0465 67 34 62</strong>. Un technicien qualifié analyse votre problème au téléphone.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="bg-navy/80 border border-white/10 rounded-2xl p-6 relative">
          <span class="text-5xl font-black text-primary/20 absolute top-4 right-4">02</span>
          <div class="w-12 h-12 bg-primary rounded-xl flex items-center justify-center text-navy font-black text-xl mb-4">
            <span class="material-icons">directions_car</span>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">2. Arrivée en &lt;45 min</h3>
          <p class="text-sm text-slate-300">
            L'électricien le plus proche de votre commune bruxelloise est envoyé chez vous immédiatement.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="bg-navy/80 border border-white/10 rounded-2xl p-6 relative">
          <span class="text-5xl font-black text-primary/20 absolute top-4 right-4">03</span>
          <div class="w-12 h-12 bg-primary rounded-xl flex items-center justify-center text-navy font-black text-xl mb-4">
            <span class="material-icons">task_alt</span>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">3. Réparation & Devis clair</h3>
          <p class="text-sm text-slate-300">
            Validation du devis sur place avant travaux, réparation sécurisée et facture d'assurance fournie.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- INTERACTIVE LIVE CALL BANNER -->
  <section class="py-14 bg-gradient-to-r from-navy via-navy-light to-navy border-b border-white/10">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <span class="material-icons text-primary text-5xl mb-2 animate-bounce">bolt</span>
      <h2 class="text-2xl sm:text-4xl font-black text-white mb-3">Ne restez pas dans le noir ou en danger</h2>
      <p class="text-slate-300 text-base sm:text-lg mb-6">
        Nos techniciens ont le matériel nécessaire dans leur camionnette pour résoudre votre panne en une seule visite.
      </p>
      <a
        href="tel:0465673462"
        class="inline-flex items-center gap-3 bg-primary hover:bg-primary-hover text-navy font-black text-xl sm:text-2xl py-4 px-8 rounded-xl shadow-xl transition-all"
        data-tracking="mid-banner-call"
      >
        <span class="material-icons text-3xl">call</span>
        <span>Appeler le 0465 67 34 62</span>
      </a>
    </div>
  </section>

  <!-- ZONES COVERED -->
  <section class="py-14 bg-navy/20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <h2 class="text-xl sm:text-2xl font-bold text-white text-center mb-6">
        📍 Zones d'intervention immédiate à Bruxelles :
      </h2>
      <div class="flex flex-wrap justify-center gap-2">
        {zones.map((zone) => (
          <span class="bg-navy border border-white/10 text-slate-300 px-3 py-1.5 rounded-lg text-xs sm:text-sm">
            {zone}
          </span>
        ))}
        <span class="bg-primary/20 border border-primary/40 text-primary font-bold px-3 py-1.5 rounded-lg text-xs sm:text-sm">
          + Périphérie & Brabant
        </span>
      </div>
    </div>
  </section>

  <!-- FAQ SECTION -->
  <section class="py-16 max-w-4xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-10">
      <h2 class="text-2xl sm:text-3xl font-black text-white mb-2">Questions fréquentes sur le dépannage</h2>
      <p class="text-slate-400 text-sm">Tout ce que vous devez savoir avant d'appeler.</p>
    </div>

    <div class="space-y-4">
      {faqs.map((faq) => (
        <details class="group bg-navy border border-white/10 rounded-xl p-5 open:border-primary/40 transition-colors">
          <summary class="flex justify-between items-center cursor-pointer font-bold text-white text-base sm:text-lg">
            <span>{faq.q}</span>
            <span class="material-icons text-primary transition-transform group-open:rotate-180">expand_more</span>
          </summary>
          <p class="mt-4 text-slate-300 text-sm leading-relaxed border-t border-white/5 pt-3">
            {faq.a}
          </p>
        </details>
      ))}
    </div>
  </section>

  <!-- FINAL HERO RECALL -->
  <section class="py-16 text-center border-t border-white/10 bg-navy/60">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="text-2xl sm:text-4xl font-black text-white mb-4">
        Un dépanneur électrique disponible à l'instant
      </h2>
      <p class="text-slate-300 text-sm sm:text-base mb-8">
        Intervention rapide, sécurité garantie et tarifs clairs. Cliquez ci-dessous pour parler directement à un technicien.
      </p>
      <a
        href="tel:0465673462"
        class="inline-flex items-center gap-3 bg-primary hover:bg-primary-hover text-navy font-black text-xl sm:text-2xl py-5 px-10 rounded-2xl shadow-xl transition-all"
        data-tracking="final-call"
      >
        <span class="material-icons text-3xl">call</span>
        <span>0465 67 34 62</span>
      </a>
    </div>
  </section>

</LPLayout>
