---
import Layout from '../layouts/Layout.astro';

const communes = [
  "Anderlecht", "Auderghem", "Berchem-Sainte-Agathe", "Bruxelles-Ville",
  "Etterbeek", "Evere", "Forest", "Ganshoren",
  "Ixelles", "Jette", "Koekelberg", "Molenbeek-Saint-Jean",
  "Saint-Gilles", "Saint-Josse-ten-Noode", "Schaerbeek", "Uccle",
  "Watermael-Boitsfort", "Woluwe-Saint-Lambert", "Woluwe-Saint-Pierre"
];

const peripherie = [
  "Zaventem", "Tervuren", "Overijse", "Hoeilaart",
  "Waterloo", "Rhode-Saint-Genèse", "Linkebeek", "Drogenbos",
  "Beersel", "Grimbergen", "Vilvoorde", "Machelen"
];
---

<Layout title="Zones d'intervention" description="Allo Electricien intervient dans les 19 communes de Bruxelles et en périphérie. Découvrez nos zones d'intervention.">

  <section class="page-header">
    <div class="container">
      <h1>Zones d'intervention</h1>
      <p>Nous intervenons dans toute la Région de Bruxelles-Capitale et en périphérie.</p>
    </div>
  </section>

  <section class="section container">
    <h2 class="section-title">Les 19 communes de Bruxelles</h2>
    <p class="section-subtitle">Nous couvrons l'ensemble de la Région de Bruxelles-Capitale.</p>
    <div class="communes-grid">
      {communes.map(commune => (
        <div class="commune-card">
          <span class="pin">&#128205;</span>
          <span>{commune}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="section" style="background: var(--bg-light);">
    <div class="container">
      <h2 class="section-title">Périphérie bruxelloise</h2>
      <p class="section-subtitle">Nous nous déplaçons également dans les communes avoisinantes.</p>
      <div class="communes-grid">
        {peripherie.map(commune => (
          <div class="commune-card">
            <span class="pin">&#128205;</span>
            <span>{commune}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section container" style="text-align: center;">
    <h2 class="section-title">Votre commune n'est pas dans la liste ?</h2>
    <p class="section-subtitle">Contactez-nous, nous pourrons peut-être nous déplacer chez vous.</p>
    <a href="/contact" class="btn">Nous contacter</a>
  </section>

</Layout>

<style>
  .page-header {
    background: linear-gradient(135deg, #1a56db 0%, #1e3a8a 100%);
    color: white;
    padding: 3.5rem 0;
    text-align: center;
  }

  .page-header h1 {
    font-size: 2.4rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .page-header p {
    font-size: 1.1rem;
    opacity: 0.9;
  }

  .communes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
  }

  .commune-card {
    background: var(--bg);
    border: 1px solid #e5e7eb;
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 500;
    transition: box-shadow 0.2s;
  }

  .commune-card:hover {
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }

  .pin {
    font-size: 1.2rem;
  }
</style>
