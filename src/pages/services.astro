---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

const servicesList = [
  {
    title: "Dépannage d'Urgence 24/7",
    href: "/services/depannage-electrique/",
    desc: "Intervention rapide en moins de 45 minutes pour pannes générales, courts-circuits, disjoncteurs qui sautent et odeurs suspectes.",
    icon: "bolt",
    tag: "Urgence 24/7",
    tagColor: "bg-red-600 text-white",
    features: ["Arrivée en < 45 min", "Diagnostic immédiat", "Mise en sécurité garantie"]
  },
  {
    title: "Installation & Rénovation",
    href: "/services/installation-renovation/",
    desc: "Rénovation électrique complète pour appartements, maisons et commerces. Câblage neuf, prises, éclairage et conformité RGIE.",
    icon: "home",
    tag: "Chantiers",
    tagColor: "bg-primary/20 text-primary border border-primary/30",
    features: ["Câblage structuré XVB", "Appareillage de marque (Niko, Legrand)", "Devis détaillé sous 48h"]
  },
  {
    title: "Mise en Conformité RGIE",
    href: "/services/mise-en-conformite-rgie/",
    desc: "Mise aux normes officielles avant vente immobilière ou après contrôle négatif. Schémas unifilaires et accompagnement certificateur.",
    icon: "verified_user",
    tag: "Normes Belges",
    tagColor: "bg-emerald-500/20 text-emerald-400 border border-emerald-500/30",
    features: ["Schémas unifilaires & position", "Mise à la terre < 30 Ohms", "Délai légal 18 mois respecté"]
  },
  {
    title: "Tableau Électrique",
    href: "/services/tableau-electrique/",
    desc: "Remplacement de tableaux anciens à fusibles, pose de disjoncteurs magnétothermiques et différentiels 30mA/300mA de type A.",
    icon: "settings_input_component",
    tag: "Sécurité",
    tagColor: "bg-accent-blue/20 text-accent-blue border border-accent-blue/30",
    features: ["Coffret modulaire ignifugé", "Différentiels 30mA & 300mA", "Équilibrage mono & triphasé"]
  },
  {
    title: "Bornes de Recharge EV",
    href: "/services/borne-recharge/",
    desc: "Installation de bornes Wallbox pour véhicules électriques et hybrides à domicile ou en copropriété avec délestage dynamique.",
    icon: "ev_station",
    tag: "Mobilité",
    tagColor: "bg-emerald-500/20 text-emerald-400 border border-emerald-500/30",
    features: ["Circuit exclusif dédié", "Protection différentielle 6mA DC", "Recharge sécurisée rapide"]
  },
  {
    title: "Domotique & Smart Home",
    href: "/services/domotique/",
    desc: "Maison connectée : contrôle à distance et centralisé de l'éclairage, du chauffage et des volets (Niko Home Control, Legrand).",
    icon: "touch_app",
    tag: "Confort",
    tagColor: "bg-purple-500/20 text-purple-300 border border-purple-500/30",
    features: ["Solutions filaires et sans fil", "Pilotage sur smartphone", "Économies d'énergie réelles"]
  }
];
---

<Layout 
  title="Services Électricien Bruxelles | Dépannage, Conformité & Travaux" 
  description="Découvrez l'ensemble de nos services d'électricité à Bruxelles et périphérie : dépannage 24/7 en moins de 45 min, conformité RGIE, tableaux, bornes EV et rénovation."
>

  <!-- Header -->
  <header class="relative bg-navy overflow-hidden pt-12 pb-24 border-b border-white/5">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(#4a4a8a 1px, transparent 1px); background-size: 30px 30px;"></div>
    <div class="absolute right-0 top-0 w-1/3 h-full bg-gradient-to-l from-primary/10 to-transparent"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 z-10">
      <span class="text-primary font-bold uppercase tracking-wider text-xs mb-3 block">Expertise Électrique Qualifiée</span>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4 tracking-tight">
        Nos Services <span class="relative inline-block">Électriques<span class="absolute bottom-1 left-0 w-full h-2 bg-primary -z-10 opacity-80 rounded-sm"></span></span>
      </h1>
      <p class="text-xl text-gray-300 max-w-2xl mt-4 leading-relaxed">
        Expertise certifiée, sécurité absolue et transparence tarifaire pour tous vos travaux et urgences électriques à Bruxelles et en périphérie.
      </p>
    </div>
  </header>

  <!-- Services Grid -->
  <main class="relative z-20 -mt-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-20">
      {servicesList.map(s => (
        <div class="group bg-navy rounded-xl border border-white/10 p-6 flex flex-col justify-between hover:border-primary/50 transition-all duration-300 shadow-xl hover:-translate-y-1">
          <div>
            <div class="flex items-center justify-between mb-6">
              <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-navy transition-colors">
                <span class="material-icons text-3xl">{s.icon}</span>
              </div>
              <span class={`text-xs font-bold px-3 py-1 rounded-full ${s.tagColor}`}>
                {s.tag}
              </span>
            </div>
            
            <h2 class="text-2xl font-bold text-white mb-3 group-hover:text-primary transition-colors">
              <a href={s.href} class="hover:underline">{s.title}</a>
            </h2>
            <p class="text-gray-300 text-sm mb-6 leading-relaxed">
              {s.desc}
            </p>
            
            <ul class="space-y-2.5 mb-8 text-sm text-gray-300">
              {s.features.map(f => (
                <li class="flex items-center gap-2">
                  <span class="material-icons text-primary text-base">check_circle</span>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="pt-4 border-t border-white/10 space-y-3">
            <a 
              href={s.href} 
              class="flex items-center justify-center gap-2 w-full py-3 bg-white/10 hover:bg-white/15 text-white font-bold rounded-lg text-sm transition-colors"
            >
              <span>Découvrir la prestation complète</span>
              <span class="material-icons text-base">arrow_forward</span>
            </a>
            <a 
              href="tel:0465673462" 
              class="flex items-center justify-center gap-2 w-full py-2.5 bg-primary text-navy font-bold rounded-lg text-sm hover:bg-primary-hover transition-colors"
            >
              <span class="material-icons text-base">phone</span>
              <span>Appeler le 0465 67 34 62</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </main>

  <!-- Urgency CTA -->
  <section class="bg-gradient-to-r from-navy to-navy-light py-16 relative overflow-hidden border-y border-primary/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 flex flex-col md:flex-row items-center justify-between text-center md:text-left gap-8">
      <div>
        <span class="bg-red-600 text-white font-bold px-3 py-1 rounded text-sm uppercase tracking-wider mb-4 inline-block">Urgence 24/7</span>
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-2">Une panne de courant ?</h2>
        <p class="text-xl text-gray-300">Intervention d'urgence en moins de 45 minutes partout à Bruxelles et environs.</p>
      </div>
      <a href="tel:0465673462" class="pulse-animation bg-primary hover:bg-primary-hover text-navy font-black text-2xl md:text-3xl px-8 py-4 rounded-full shadow-lg transition-transform flex items-center gap-4">
        <span class="material-icons text-3xl">phone_in_talk</span>
        0465 67 34 62
      </a>
    </div>
  </section>

  <!-- Process -->
  <section class="py-20 bg-bg-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-white text-center mb-16">Notre Processus d'Intervention</h2>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <div class="flex flex-col items-center text-center group">
          <div class="w-16 h-16 bg-navy border-2 border-primary rounded-full flex items-center justify-center mb-4 shadow-lg group-hover:scale-110 transition-transform">
            <span class="material-icons text-primary text-2xl">call</span>
          </div>
          <h3 class="text-xl font-bold text-white mb-2">1. Prise de contact</h3>
          <p class="text-gray-400 text-sm">Écoute de votre demande, conseils immédiats et diagnostic préliminaire.</p>
        </div>
        <div class="flex flex-col items-center text-center group">
          <div class="w-16 h-16 bg-navy border-2 border-primary rounded-full flex items-center justify-center mb-4 shadow-lg group-hover:scale-110 transition-transform">
            <span class="material-icons text-primary text-2xl">description</span>
          </div>
          <h3 class="text-xl font-bold text-white mb-2">2. Devis Transparent</h3>
          <p class="text-gray-400 text-sm">Tarif annoncé avant toute manipulation ou devis détaillé gratuit sous 48h.</p>
        </div>
        <div class="flex flex-col items-center text-center group">
          <div class="w-16 h-16 bg-navy border-2 border-primary rounded-full flex items-center justify-center mb-4 shadow-lg group-hover:scale-110 transition-transform">
            <span class="material-icons text-primary text-2xl">engineering</span>
          </div>
          <h3 class="text-xl font-bold text-white mb-2">3. Réalisation certifiée</h3>
          <p class="text-gray-400 text-sm">Travaux soignés réalisés par un électricien agréé selon les règles du RGIE.</p>
        </div>
        <div class="flex flex-col items-center text-center group">
          <div class="w-16 h-16 bg-navy border-2 border-primary rounded-full flex items-center justify-center mb-4 shadow-lg group-hover:scale-110 transition-transform">
            <span class="material-icons text-primary text-2xl">task_alt</span>
          </div>
          <h3 class="text-xl font-bold text-white mb-2">4. Conformité & Garantie</h3>
          <p class="text-gray-400 text-sm">Vérification de bon fonctionnement, schémas réglementaires et garantie des travaux.</p>
        </div>
      </div>
    </div>
  </section>

</Layout>
