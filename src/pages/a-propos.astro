---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

// TODO (Propriétaire) : Confirmer l'année exacte de création de l'entreprise et le numéro d'entreprise BCE pour mention officielle.
---

<Layout 
  title="À Propos d'Allo Électricien | Électriciens Qualifiés à Bruxelles" 
  description="Découvrez Allo Électricien, vos électriciens qualifiés à Bruxelles et périphérie. Dépannage d'urgence 24/7, conformité RGIE, devis transparent et travaux soignés."
>

  <!-- Header -->
  <header class="relative bg-navy overflow-hidden pt-12 pb-24 border-b border-white/5">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(#4a4a8a 1px, transparent 1px); background-size: 30px 30px;"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 z-10">
      <span class="text-primary font-bold uppercase tracking-wider text-xs mb-3 block">Qui Sommes-Nous</span>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4 tracking-tight">
        À <span class="text-primary">Propos</span> d'Allo Électricien
      </h1>
      <p class="text-xl text-gray-300 max-w-2xl mt-4 leading-relaxed">
        Votre partenaire électricien de référence pour le dépannage d'urgence, la rénovation et la conformité RGIE à Bruxelles et en périphérie.
      </p>
    </div>
  </header>

  <main class="relative z-20 -mt-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">

    <!-- Notre Histoire -->
    <section class="bg-navy rounded-2xl border border-white/10 p-8 md:p-12 shadow-2xl mb-16">
      <div class="max-w-3xl">
        <span class="text-primary font-bold tracking-wider uppercase text-sm mb-2 block">Notre Métier</span>
        <h2 class="text-3xl font-bold text-white mb-6">Un engagement constant au service de la sécurité électrique</h2>
        <div class="space-y-4 text-gray-300 leading-relaxed text-sm md:text-base">
          <p>
            Allo Électricien est une structure spécialisée dans l'électricité générale, le dépannage rapide d'urgence et la mise en conformité des installations à Bruxelles. Nous accompagnons les particuliers, les copropriétés, les syndics et les commerçants dans l'ensemble de la Région de Bruxelles-Capitale ainsi que dans les communes limitrophes du Brabant wallon et flamand.
          </p>
          <p>
            Notre engagement repose sur trois principes fondamentaux : la <strong>sécurité absolue</strong> des personnes et des biens selon les normes du RGIE belge, la <strong>transparence tarifaire</strong> avant toute manipulation technique, et la <strong>réactivité</strong> face aux situations d'urgence (coupures de courant, courts-circuits, surchauffes).
          </p>
        </div>
      </div>
    </section>

    <!-- Points Clés -->
    <section class="bg-navy-light rounded-2xl border border-white/10 p-8 mb-16">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div>
          <div class="text-4xl font-bold text-primary mb-2">24/7</div>
          <div class="text-gray-300 text-sm uppercase tracking-wider font-semibold">Service d'Urgence</div>
        </div>
        <div>
          <div class="text-4xl font-bold text-primary mb-2">&lt; 45m</div>
          <div class="text-gray-300 text-sm uppercase tracking-wider font-semibold">Délai d'Arrivée Moyen</div>
        </div>
        <div>
          <div class="text-4xl font-bold text-primary mb-2">19</div>
          <div class="text-gray-300 text-sm uppercase tracking-wider font-semibold">Communes Desservies</div>
        </div>
        <div>
          <div class="text-4xl font-bold text-primary mb-2">100%</div>
          <div class="text-gray-300 text-sm uppercase tracking-wider font-semibold">Conforme RGIE</div>
        </div>
      </div>
    </section>

    <!-- Valeurs -->
    <section class="mb-16">
      <div class="text-center mb-12">
        <span class="text-primary font-bold tracking-wider uppercase text-sm mb-2 block">Nos Principes</span>
        <h2 class="text-3xl font-bold text-white mb-4">Nos Valeurs</h2>
        <div class="h-1 w-20 bg-primary mx-auto rounded-full"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-navy p-8 rounded-xl shadow-lg border-b-4 border-primary hover:-translate-y-2 transition-transform duration-300">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mb-6 mx-auto">
            <span class="material-icons text-3xl text-primary">workspace_premium</span>
          </div>
          <h3 class="text-xl font-bold text-white text-center mb-3">Rigueur & RGIE</h3>
          <p class="text-gray-400 text-center text-sm">Chaque raccordement, chaque disjoncteur et chaque liaison de terre est installé dans le respect scrupuleux du Règlement Général sur les Installations Électriques.</p>
        </div>
        <div class="bg-navy p-8 rounded-xl shadow-lg border-b-4 border-primary hover:-translate-y-2 transition-transform duration-300">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mb-6 mx-auto">
            <span class="material-icons text-3xl text-primary">visibility</span>
          </div>
          <h3 class="text-xl font-bold text-white text-center mb-3">Transparence Totale</h3>
          <p class="text-gray-400 text-center text-sm">Devis clair annoncé avant chaque travail. En dépannage d'urgence comme en rénovation, vous validez l'intervention avant le début des travaux.</p>
        </div>
        <div class="bg-navy p-8 rounded-xl shadow-lg border-b-4 border-primary hover:-translate-y-2 transition-transform duration-300">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mb-6 mx-auto">
            <span class="material-icons text-3xl text-primary">speed</span>
          </div>
          <h3 class="text-xl font-bold text-white text-center mb-3">Disponibilité 24/7</h3>
          <p class="text-gray-400 text-center text-sm">Parce qu'une coupure d'électricité en hiver ou un court-circuit ne prévient pas, nous maintenons un service de garde d'urgence joignable jour et nuit.</p>
        </div>
      </div>
    </section>

    <!-- Engagements -->
    <section class="mb-16">
      <div class="text-center mb-12">
        <span class="text-primary font-bold tracking-wider uppercase text-sm mb-2 block">Excellence Technique</span>
        <h2 class="text-3xl font-bold text-white mb-4">Nos Engagements Qualité</h2>
        <div class="h-1 w-20 bg-primary mx-auto rounded-full"></div>
      </div>
      <div class="bg-navy rounded-2xl border border-white/10 p-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-4xl mx-auto">
          <div class="flex items-center gap-4 p-4 rounded-lg bg-white/5 border border-white/5">
            <span class="material-icons text-green-500 text-2xl flex-shrink-0">check_circle</span>
            <p class="text-gray-200 text-sm">Conformité intégrale au RGIE belge (Livre 1)</p>
          </div>
          <div class="flex items-center gap-4 p-4 rounded-lg bg-white/5 border border-white/5">
            <span class="material-icons text-green-500 text-2xl flex-shrink-0">check_circle</span>
            <p class="text-gray-200 text-sm">Devis détaillé gratuit sans engagement</p>
          </div>
          <div class="flex items-center gap-4 p-4 rounded-lg bg-white/5 border border-white/5">
            <span class="material-icons text-green-500 text-2xl flex-shrink-0">check_circle</span>
            <p class="text-gray-200 text-sm">Garantie légale sur les pièces et la main-d'œuvre</p>
          </div>
          <div class="flex items-center gap-4 p-4 rounded-lg bg-white/5 border border-white/5">
            <span class="material-icons text-green-500 text-2xl flex-shrink-0">check_circle</span>
            <p class="text-gray-200 text-sm">Matériel professionnel certifié CE et CEBEC (Hager, Schneider, Niko)</p>
          </div>
          <div class="flex items-center gap-4 p-4 rounded-lg bg-white/5 border border-white/5">
            <span class="material-icons text-green-500 text-2xl flex-shrink-0">check_circle</span>
            <p class="text-gray-200 text-sm">Schémas unifilaires et de position aux normes</p>
          </div>
          <div class="flex items-center gap-4 p-4 rounded-lg bg-white/5 border border-white/5">
            <span class="material-icons text-green-500 text-2xl flex-shrink-0">check_circle</span>
            <p class="text-gray-200 text-sm">Facture officielle détaillée acceptée par les assurances</p>
          </div>
        </div>
      </div>
    </section>

  </main>

  <!-- CTA -->
  <section class="bg-navy py-24 text-center">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl md:text-5xl font-bold text-white mb-6">Besoin d'un électricien de confiance ?</h2>
      <p class="text-xl text-gray-300 mb-10">Nos équipes interviennent en moins de 45 minutes pour vos urgences ou établissent votre devis sous 24 à 48h.</p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="tel:0465673462" class="flex items-center justify-center gap-2 bg-primary hover:bg-primary-hover text-navy font-bold text-lg px-8 py-4 rounded-lg transition-colors shadow-lg shadow-primary/20">
          <span class="material-icons">phone</span>Appeler le 0465 67 34 62
        </a>
        <a href="/contact/" class="flex items-center justify-center gap-2 bg-transparent border-2 border-white text-white hover:bg-white hover:text-navy font-bold text-lg px-8 py-4 rounded-lg transition-colors">
          <span class="material-icons">description</span>Demander un Devis
        </a>
      </div>
    </div>
  </section>

</Layout>
