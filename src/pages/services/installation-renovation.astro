---
import Layout from '../../layouts/Layout.astro';
import CTABanner from '../../components/CTABanner.astro';

const faqs = [
  {
    question: "Combien coûte la rénovation électrique d'un appartement à Bruxelles ?",
    answer: "Le coût dépend de la surface, de l'état du câblage existant (nécessité de saignées ou pose sous goulottes), du nombre de circuits et du remplacement éventuel du tableau électrique. Nous réalisons une visite technique préalable gratuite pour établir un devis poste par poste sans mauvaise surprise."
  },
  {
    question: "Quelles normes s'appliquent pour les travaux de rénovation en Belgique ?",
    answer: "Toute rénovation ou extension doit être réalisée en stricte conformité avec le Règlement Général sur les Installations Électriques (RGIE Livre 1). Cela implique notamment des sections de câbles normalisées (1,5 mm² pour l'éclairage, 2,5 mm² pour les prises), la liaison équipotentielle et la fourniture de schémas unifilaires et de position."
  },
  {
    question: "Faut-il casser les murs pour refaire l'électricité d'une maison ancienne ?",
    answer: "Pas nécessairement. Selon vos préférences esthétiques et votre budget, nous combinons des saignées soignées dans les cloisons avec des passages en vide ventilé, faux-plafonds ou plinthes techniques pour minimiser les travaux de plâtrerie ultérieurs."
  },
  {
    question: "Fournissez-vous les schémas électriques réglementaires ?",
    answer: "Oui. Pour tout chantier de rénovation complète ou modification importante, nous réalisons systématiquement le schéma unifilaire et le plan de position indispensables pour le contrôle de conformité par un organisme agréé."
  }
];

const schemaFAQ = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
};
---

<Layout 
  title="Installation & Rénovation Électrique Bruxelles | Devis Gratuit" 
  description="Travaux d'installation et rénovation électrique à Bruxelles. Câblage neuf, tableau, prises, éclairage aux normes RGIE. Devis détaillé gratuit au 0465 67 34 62."
>
  <header class="relative bg-navy overflow-hidden pt-12 pb-20 border-b border-white/5">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(#4a4a8a 1px, transparent 1px); background-size: 30px 30px;"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 z-10">
      <span class="text-primary font-bold uppercase tracking-wider text-xs mb-3 block">Travaux Résidentiels & Tertiaires</span>
      <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-6 tracking-tight">
        Installation & Rénovation Électrique à Bruxelles
      </h1>
      <p class="text-xl text-gray-300 max-w-3xl leading-relaxed mb-8">
        Vous rénovez une maison de maître, un appartement ou un commerce ? Confiez vos travaux à des électriciens qualifiés. Nous concevons et réalisons des installations électriques modernes, pérennes et 100% conformes au RGIE belge.
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a href="/contact/" class="flex items-center justify-center gap-2 bg-primary hover:bg-primary-hover text-navy font-bold text-base px-8 py-4 rounded-xl shadow-lg shadow-primary/25 transition-transform hover:-translate-y-0.5">
          <span class="material-icons">description</span>
          Demander un Devis Gratuit
        </a>
        <a href="tel:0465673462" class="flex items-center justify-center gap-2 bg-white/10 hover:bg-white/15 text-white font-bold text-base px-6 py-4 rounded-xl border border-white/10 transition-colors">
          <span class="material-icons">phone</span>
          Conseil technique : 0465 67 34 62
        </a>
      </div>
    </div>
  </header>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-16">
    
    <!-- Prestations proposées -->
    <section>
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">Nos prestations d'installation et de rénovation</h2>
        <p class="text-gray-300 text-sm">De la pose de quelques circuits supplémentaires à la refonte intégrale de votre réseau électrique.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="bg-navy p-6 rounded-xl border border-white/10">
          <div class="w-12 h-12 rounded-lg bg-primary/20 text-primary flex items-center justify-center mb-4">
            <span class="material-icons text-2xl">home_repair_service</span>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Rénovation électrique complète</h3>
          <p class="text-gray-400 text-sm">Dépose de l'ancienne installation vétuste, tirage de gaines ICTA et câbles XVB aux normes, pose de nouveaux circuits protégés pour chaque pièce de vie.</p>
        </div>

        <div class="bg-navy p-6 rounded-xl border border-white/10">
          <div class="w-12 h-12 rounded-lg bg-primary/20 text-primary flex items-center justify-center mb-4">
            <span class="material-icons text-2xl">bathtub</span>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Électricité salle de bain & cuisine</h3>
          <p class="text-gray-400 text-sm">Application rigoureuse des volumes de sécurité 0, 1 et 2 selon le RGIE en salle d'eau (liaison équipotentielle supplémentaire, différentiel 30 mA). Circuits dédiés 32A pour taques induction et électroménager.</p>
        </div>

        <div class="bg-navy p-6 rounded-xl border border-white/10">
          <div class="w-12 h-12 rounded-lg bg-primary/20 text-primary flex items-center justify-center mb-4">
            <span class="material-icons text-2xl">power</span>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Prises, interrupteurs & appareillage</h3>
          <p class="text-gray-400 text-sm">Pose et encastrement d'appareillage haut de gamme (Niko, Legrand). Respect du nombre minimal de prises par circuit imposé par la législation belge (maximum 8 points par circuit).</p>
        </div>

        <div class="bg-navy p-6 rounded-xl border border-white/10">
          <div class="w-12 h-12 rounded-lg bg-primary/20 text-primary flex items-center justify-center mb-4">
            <span class="material-icons text-2xl">lightbulb</span>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Éclairage architectural & LED</h3>
          <p class="text-gray-400 text-sm">Installation de spots encastrés, rubans LED indirects, suspensions design et variateurs pour optimiser le confort visuel tout en divisant votre facture énergétique.</p>
        </div>

        <div class="bg-navy p-6 rounded-xl border border-white/10">
          <div class="w-12 h-12 rounded-lg bg-primary/20 text-primary flex items-center justify-center mb-4">
            <span class="material-icons text-2xl">lan</span>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Câblage réseau RJ45 & multimédia</h3>
          <p class="text-gray-400 text-sm">Tirage de câbles Ethernet blindés Cat 6A / Cat 7 et installation de coffrets de communication pour garantir un débit internet optimal dans toutes vos pièces.</p>
        </div>

        <div class="bg-navy p-6 rounded-xl border border-white/10">
          <div class="w-12 h-12 rounded-lg bg-primary/20 text-primary flex items-center justify-center mb-4">
            <span class="material-icons text-2xl">engineering</span>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Mise à la terre réglementaire</h3>
          <p class="text-gray-400 text-sm">Fonçage de piquets de terre en cuivre, mesure de résistance (valeur impérativement &lt; 30 ohms) et installation du sectionneur de terre avec liaison équipotentielle principale.</p>
        </div>
      </div>
    </section>

    <!-- Notre Processus -->
    <section class="bg-navy-light rounded-2xl p-8 border border-white/10">
      <h2 class="text-2xl font-bold text-white mb-8 text-center">Déroulement de votre projet de rénovation</h2>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="space-y-2">
          <div class="text-primary font-bold text-sm uppercase">Étape 1</div>
          <h3 class="text-white font-bold text-base">Visite technique sur site</h3>
          <p class="text-gray-400 text-sm">Relevé de l'existant, écoute de vos besoins (plans d'aménagement, souhaits d'éclairage) et vérification du raccordement Sibelga.</p>
        </div>
        <div class="space-y-2">
          <div class="text-primary font-bold text-sm uppercase">Étape 2</div>
          <h3 class="text-white font-bold text-base">Devis détaillé sous 48h</h3>
          <p class="text-gray-400 text-sm">Chiffrage clair par poste (matériel, main-d'œuvre, tableau, schémas). Aucun coût caché.</p>
        </div>
        <div class="space-y-2">
          <div class="text-primary font-bold text-sm uppercase">Étape 3</div>
          <h3 class="text-white font-bold text-base">Réalisation soignée</h3>
          <p class="text-gray-400 text-sm">Intervention d'électriciens qualifiés, respect des délais convenus et protection des sols et du mobilier sur le chantier.</p>
        </div>
        <div class="space-y-2">
          <div class="text-primary font-bold text-sm uppercase">Étape 4</div>
          <h3 class="text-white font-bold text-base">Contrôle de réception</h3>
          <p class="text-gray-400 text-sm">Remise des schémas officiels et accompagnement pour l'obtention du certificat de conformité RGIE sans réserve.</p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="max-w-4xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-bold text-white text-center mb-8">Questions Fréquentes sur l'Installation & Rénovation</h2>
      <div class="space-y-4">
        {faqs.map(f => (
          <details class="group bg-navy border border-white/10 rounded-xl overflow-hidden">
            <summary class="flex justify-between items-center p-6 cursor-pointer text-white font-semibold hover:text-primary transition-colors">
              <span>{f.question}</span>
              <span class="material-icons text-primary transition-transform group-open:rotate-180">expand_more</span>
            </summary>
            <div class="p-6 pt-0 text-gray-300 text-sm leading-relaxed border-t border-white/5">
              <p>{f.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </section>

  </div>

  <CTABanner 
    title="Un projet de rénovation électrique à Bruxelles ?" 
    subtitle="Contactez-nous pour organiser une visite technique préalable et recevoir votre devis gratuit sans engagement." 
  />

  <script type="application/ld+json" set:html={JSON.stringify(schemaFAQ)} />
</Layout>
